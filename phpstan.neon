includes:
    - phpstan-baseline.neon
    - vendor/larastan/larastan/extension.neon

parameters:
    # Level 5 with a generated baseline: a ratchet for new code, not a rewrite
    # of what already ships. Raise the level or shrink the baseline, never both
    # in the same commit.
    level: 5
    paths:
        - src

    # A PHPDoc correction for statamic/cms's `$vite` property, and nothing
    # else. See the file for why it is a stub rather than a baseline entry.
    stubFiles:
        - .phpstan/addon-service-provider-stubs.php

    # Das Analytics-Addon ist ein `suggest`, kein `require`: die Kennzahlen
    # unter src/Integrations/Insights erweitern seinen Vertrag, und es liegt
    # nicht in vendor/. Gelesen werden die Stellvertreter aus der Testsuite —
    # dieselben Deklarationen, Byte fuer Byte —, damit die Kennzahlen gegen die
    # echten Signaturen geprueft werden statt als unbekannte Klassen zu gelten.
    # Gescannt, nicht analysiert: die Dateien sind kein Code, den dieses Paket
    # ausliefert.
    scanFiles:
        - tests/Fakes/insights-contracts.php
        - tests/Fakes/insights-table-metric.php

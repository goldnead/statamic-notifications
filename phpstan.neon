includes:
    - phpstan-baseline.neon
    - vendor/larastan/larastan/extension.neon

parameters:
    # Level 5 with a generated baseline: a ratchet for new code, not a rewrite
    # of what already ships. Raise the level or shrink the baseline, never both
    # in the same commit.
    level: 5
    paths:
        - src

    # A PHPDoc correction for statamic/cms's `$vite` property, and nothing
    # else. See the file for why it is a stub rather than a baseline entry.
    stubFiles:
        - .phpstan/addon-service-provider-stubs.php

    # Das Analytics-Addon ist ein `suggest`, kein `require`: die Kennzahlen
    # unter src/Integrations/Insights erweitern seinen Vertrag, und es liegt
    # nicht in vendor/. Gelesen werden die Stellvertreter aus der Testsuite —
    # dieselben Deklarationen, Byte fuer Byte —, damit die Kennzahlen gegen die
    # echten Signaturen geprueft werden statt als unbekannte Klassen zu gelten.
    # Gescannt, nicht analysiert: die Dateien sind kein Code, den dieses Paket
    # ausliefert.
    scanFiles:
        - tests/Fakes/insights-contracts.php
        - tests/Fakes/insights-table-metric.php

    # Die view-string-Ausnahme unten greift nur ab Larastan 3.12. Die CI loest
    # frisch auf und bekommt sie; eine Arbeitskopie mit 3.11 in der Lockdatei
    # nicht, und wuerde dann an der UNGENUTZTEN Ausnahme scheitern. Gleiche
    # Einstellung, gleicher Grund, wie in statamic-marketing und statamic-payments.
    reportUnmatchedIgnoredErrors: false

    ignoreErrors:
        # Larastan prueft ab 3.12 eine view-string, indem es den View-Finder
        # fragt, ob die Vorlage existiert. Dieses Addon meldet seinen
        # `notifications::`-Namensraum erst beim Booten ueber loadViewsFrom()
        # an, und das laeuft in der Analyse nie. Ein Befund ueber die
        # Analyseumgebung, keiner ueber eine View. Dieselbe Ausnahme wie in
        # statamic-marketing, statamic-automations, statamic-lead-magnets und
        # statamic-payments.
        -
            identifier: argument.type
            message: '#expects view-string(\|null)?, string given#'

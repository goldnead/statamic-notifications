{
    "name": "goldnead/statamic-notifications",
    "description": "Persisted, brand-scoped notifications for Statamic: types, per-type preferences, in-app, immediate mail and deduplicated digests.",
    "type": "statamic-addon",
    "license": "MIT",
    "keywords": [
        "statamic",
        "statamic-addon",
        "notifications",
        "digest",
        "realtime"
    ],
    "authors": [
        {
            "name": "Adrian Goldner",
            "email": "info@adriangoldner.com"
        }
    ],
    "support": {
        "issues": "https://github.com/goldnead/statamic-notifications/issues",
        "source": "https://github.com/goldnead/statamic-notifications"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/goldnead/statamic-brand-context.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/goldnead/statamic-identity-contracts.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/goldnead/statamic-leadhub.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/goldnead/statamic-suppression.git"
        }
    ],
    "require": {
        "goldnead/statamic-brand-context": "^1.0",
        "goldnead/statamic-identity-contracts": "^1.0",
        "goldnead/statamic-suppression": "^1.0",
        "laravel/framework": "^12.0|^13.0",
        "php": "^8.3",
        "statamic/cms": "^6.0"
    },
    "require-dev": {
        "goldnead/statamic-leadhub": "^1.4",
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.30",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^2.0|^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^2.0|^3.0|^4.0"
    },
    "suggest": {
        "goldnead/statamic-leadhub": "Enables the bundled CRM source (new leads, assignments, follow-up digests)."
    },
    "autoload": {
        "psr-4": {
            "Goldnead\\Notifications\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Goldnead\\Notifications\\Tests\\": "tests/"
        }
    },
    "extra": {
        "statamic": {
            "slug": "notifications",
            "name": "Notifications",
            "url": "https://github.com/goldnead/statamic-notifications",
            "description": "Persisted, brand-scoped notifications with per-type preferences and digests.",
            "developer": "Adrian Goldner",
            "developer-url": "https://gldnr.studio"
        },
        "laravel": {
            "providers": [
                "Goldnead\\Notifications\\ServiceProvider"
            ],
            "aliases": {
                "Notifications": "Goldnead\\Notifications\\Facades\\Notifications"
            }
        }
    },
    "scripts": {
        "test": [
            "@php vendor/bin/pest"
        ],
        "lint": [
            "@php vendor/bin/pint --test"
        ],
        "analyse": [
            "@php vendor/bin/phpstan analyse"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "pixelfear/composer-dist-plugin": true,
            "composer/installers": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

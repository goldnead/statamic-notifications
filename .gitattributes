# Without this, every site that installs the addon downloads its tests, CI config,
# listing artwork and dev tooling. Runway, Mailchimp and Advanced SEO all
# export-ignore.

/.github                export-ignore
/tests                  export-ignore
/art                    export-ignore
/screenshots            export-ignore
/.gitattributes         export-ignore
/.gitignore             export-ignore
/.editorconfig          export-ignore
/phpunit.xml            export-ignore
/phpunit.xml.dist       export-ignore
/phpunit.mysql.xml      export-ignore
/pint.json              export-ignore
/phpstan.neon           export-ignore
/phpstan-baseline.neon  export-ignore
/.phpstan               export-ignore
/addon-lint.json        export-ignore

# The CP build's sources and tooling. `resources/dist` is deliberately NOT
# listed: it is the compiled bundle a Composer install actually loads, and a
# Marketplace install never runs npm.
/package.json           export-ignore
/package-lock.json      export-ignore
/vite.config.js         export-ignore
/resources/js           export-ignore
/resources/css          export-ignore
/scripts                export-ignore

# Keep: /config, /database, /resources/dist, /resources/lang, /resources/svg,
# /resources/views, /routes, /src, README.md, CHANGELOG.md, LICENSE.
